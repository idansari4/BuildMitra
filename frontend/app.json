{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.buildmitra.f7afnf"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Capture selfies to verify your attendance"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Verify your attendance at job sites"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Capture selfies for attendance verification"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture attendance selfies",
        "NSLocationWhenInUseUsageDescription": "Verify attendance location",
        "NSPhotoLibraryUsageDescription": "Pick profile photos"
      },
      "bundleIdentifier": "com.emergent.buildmitra.f7afnf"
    },
    "android_permissions_placeholder": [
      "CAMERA",
      "ACCESS_FINE_LOCATION",
      "ACCESS_COARSE_LOCATION"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
