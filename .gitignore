# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies — path-specific so Expo web build's assets/node_modules/ (fonts, glyphs) survives
/node_modules
/node_modules/
/frontend/node_modules/
/backend/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
# NOTE: frontend/dist/ MUST be included in deployment (backend serves SPA from it).
# Removed generic `dist/` ignore — the whitelist below un-ignores frontend/dist
# including its nested assets/node_modules subpath (font glyphs, expo-router assets).
!frontend/dist/
!frontend/dist/**
!frontend/dist/assets/
!frontend/dist/assets/**
!frontend/dist/assets/node_modules/
!frontend/dist/assets/node_modules/**

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/
.env
.env.*
*.env
credentials.json
*.key
.credentials
